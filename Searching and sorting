1. LINEAR SEARCH:

class LinearSearch {
    public static void main(String[] args) {
        int a[] = {10, 20, 30, 40, 50};
        int key = 30;

        for(int i=0; i<a.length; i++) {
            if(a[i] == key) {
                System.out.println("Found at index " + i);
                return;
            }
        }
        System.out.println("Not Found");
    }
}

2.BINARY SEARCH:

class BinarySearch {
    public static void main(String[] args) {
        int a[] = {10, 20, 30, 40, 50};
        int key = 30;
        int l = 0, r = 4;

        while(l <= r) {
            int m = (l + r) / 2;

            if(a[m] == key) {
                System.out.println("Found at index " + m);
                return;
            }
            if(a[m] < key)
                l = m + 1;
            else
                r = m - 1;
        }
        System.out.println("Not Found");
    }
}

3.SELECTION SORT:

class SelectionSort {
    public static void main(String[] args) {
        int a[] = {5, 3, 4, 1, 2};

        for(int i=0; i<a.length-1; i++) {
            int min = i;

            for(int j=i+1; j<a.length; j++)
                if(a[j] < a[min])
                    min = j;

            int t = a[i];
            a[i] = a[min];
            a[min] = t;
        }

        for(int x : a)
            System.out.print(x + " ");
    }
}

4.INSERTION SORT:

class InsertionSort {
    public static void main(String[] args) {
        int a[] = {5, 3, 4, 1, 2};

        for(int i=1; i<a.length; i++) {
            int key = a[i];
            int j = i-1;

            while(j>=0 && a[j]>key) {
                a[j+1] = a[j];
                j--;
            }
            a[j+1] = key;
        }

        for(int x : a)
            System.out.print(x + " ");
    }
}

5. BUBBLE SORT:

class BubbleSort {
    public static void main(String[] args) {
        int a[] = {5, 3, 4, 1, 2};

        for(int i=0; i<a.length-1; i++) {
            for(int j=0; j<a.length-i-1; j++) {
                if(a[j] > a[j+1]) {
                    int t = a[j];
                    a[j] = a[j+1];
                    a[j+1] = t;
                }
            }
        }

        for(int x : a)
            System.out.print(x + " ");
    }
}







