import java.util.*;

class Main {
    public static void main(String[] args) {

        int radius = 1;
        int xCenter = 0;
        int yCenter = 0;
        int x1 = 1;
        int y1 = -1;
        int x2 = 3;
        int y2 = 1;

        int x = Math.max(x1, Math.min(xCenter, x2));
        int y = Math.max(y1, Math.min(yCenter, y2));

        int dx = x - xCenter;
        int dy = y - yCenter;

        boolean result = dx * dx + dy * dy <= radius * radius;

        System.out.println(result);
    }
}class Solution {
    public int totalNumbers(int[] digits) {
        int count = 0;

        for (int a = 1; a <= 9; a++) {
            for (int b = 0; b <= 9; b++) {
                for (int c = 0; c <= 8; c += 2) {

                    if (a == b || a == c || b == c)
                        continue;

                    boolean x = false, y = false, z = false;

                    for (int d : digits) {
                        if (d == a && !x) x = true;
                        else if (d == b && !y) y = true;
                        else if (d == c && !z) z = true;
                    }

                    if (x && y && z)
                        count++;
                }
            }
        }

        return count;
    }
}


3. Find Two Non-overlapping Sub-arrays Each With Target Sum.



import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] arr = {3, 2, 2, 4, 3};
        int target = 3;

        int n = arr.length;
        int[] best = new int[n];

        int sum = 0;
        int left = 0;
        int ans = Integer.MAX_VALUE;
        int minLen = Integer.MAX_VALUE;

        for (int right = 0; right < n; right++) {
            sum += arr[right];

            while (sum > target) {
                sum -= arr[left];
                left++;
            }

            if (sum == target) {
                int len = right - left + 1;

                if (left > 0 && best[left - 1] != 0) {
                    ans = Math.min(ans, len + best[left - 1]);
                }

                minLen = Math.min(minLen, len);
            }

            best[right] = minLen == Integer.MAX_VALUE ? 0 : minLen;
        }

        System.out.println(ans == Integer.MAX_VALUE ? -1 : ans);
    }
}

4. Distinct Subsequences II

class Main {
    public static int distinctSubseqII(String s) {
        long[] dp = new long[26];
        long total = 0;
        long mod = 1000000007;

        for (char c : s.toCharArray()) {
            int i = c - 'a';

            long add = (total + 1) % mod;

            total = (total + add - dp[i] + mod) % mod;

            dp[i] = add;
        }

        return (int) total;
    }

    public static void main(String[] args) {
        String s = "abc";

        System.out.println(distinctSubseqII(s));
    }
}

5. Maximize the Distance Between Points on a Square:


import java.util.*;

class Main {

    public static int maxDistance(int side, int[][] points, int k) {
        
        long[] a = new long[points.length];

        for (int i = 0; i < points.length; i++) {
            int x = points[i][0];
            int y = points[i][1];

            if (x == 0)
                a[i] = y;
            else if (y == side)
                a[i] = side + x;
            else if (x == side)
                a[i] = 3L * side - y;
            else
                a[i] = 4L * side - x;
        }

        Arrays.sort(a);

        long left = 0, right = side;

        while (left < right) {
            long mid = (left + right + 1) / 2;

            if (check(a, side, k, mid))
                left = mid;
            else
                right = mid - 1;
        }

        return (int) left;
    }

    static boolean check(long[] a, int side, int k, long d) {

        long perimeter = 4L * side;
        int n = a.length;

        for (int s = 0; s < n; s++) {

            long start = a[s];
            long last = start;
            int count = 1;

            for (int j = 1; j < n && count < k; j++) {

                int index = (s + j) % n;
                long cur = a[index];

                if (index <= s)
                    cur += perimeter;

                if (cur - last >= d) {
                    last = cur;
                    count++;
                }
            }

            if (count == k && perimeter - (last - start) >= d)
                return true;
        }

        return false;
    }

    public static void main(String[] args) {

        int side = 2;

        int[][] points = {
            {0, 2},
            {2, 0},
            {2, 2},
            {0, 0}
        };

        int k = 4;

        System.out.println(maxDistance(side, points, k));
    }
}

6. CODE NODE EQUALS TO AVERAGE OF SUBTREE:


class Main {

    static class TreeNode {
        int val;
        TreeNode left, right;

        TreeNode(int val) {
            this.val = val;
        }
    }

    static int count = 0;

    static int[] dfs(TreeNode root) {
        if (root == null)
            return new int[]{0, 0};

        int[] left = dfs(root.left);
        int[] right = dfs(root.right);

        int sum = left[0] + right[0] + root.val;
        int nodes = left[1] + right[1] + 1;

        if (sum / nodes == root.val)
            count++;

        return new int[]{sum, nodes};
    }

    public static void main(String[] args) {

        TreeNode root = new TreeNode(4);

        root.left = new TreeNode(8);
        root.right = new TreeNode(5);

        root.left.left = new TreeNode(0);
        root.left.right = new TreeNode(1);

        root.right.right = new TreeNode(6);

        dfs(root);

        System.out.println(count);
    }
}

7. Maximum Score From Grid Operations

import java.util.*;
public class Main {

    public static long maximumScore(int[][] grid) {
        int n = grid.length;
        long[][] s = new long[n][n + 1];

        // Column prefix sums calculation
        for (int j = 0; j < n; ++j) {
            for (int i = 0; i < n; ++i) {
                s[j][i + 1] = s[j][i] + grid[i][j];
            }
        }

        long INF = (long) -1e15;
        long[][] f = new long[n + 1][n + 1];
        for (int i = 0; i <= n; i++) {
            for (int j = 0; j <= n; j++) {
                f[i][j] = INF;
            }
        }

        for (int h = 0; h <= n; ++h) {
            f[h][0] = 0;
        }

        for (int j = 0; j < n - 1; ++j) {
            long[][] g = new long[n + 1][n + 1];
            for (int i = 0; i <= n; i++) {
                for (int k = 0; k <= n; k++) {
                    g[i][k] = INF;
                }
            }

            for (int h1 = 0; h1 <= n; ++h1) {
                long[] pre = new long[n + 2];
                pre[0] = f[h1][0];
                for (int h2 = 1; h2 <= n; ++h2) {
                    pre[h2] = Math.max(pre[h2 - 1], f[h1][h2]);
                }

                long[] suf = new long[n + 2];
                for (int i = 0; i <= n + 1; i++) suf[i] = INF;

                for (int h2 = n; h2 >= 0; --h2) {
                    long val = (f[h1][h2] == INF) ? INF : f[h1][h2] + Math.max(0, s[j][h2] - s[j][h1]);
                    suf[h2] = Math.max(suf[h2 + 1], val);
                }

                for (int hp = 0; hp <= n; ++hp) {
                    long add = Math.max(0, s[j][hp] - s[j][h1]);
                    long v1 = (pre[hp] == INF) ? INF : pre[hp] + add;
                    g[hp][h1] = Math.max(v1, suf[hp + 1]);
                }
            }
            f = g;
        }

        long ans = 0;
        for (int h1 = 0; h1 <= n; ++h1) {
            for (int h2 = 0; h2 <= n; ++h2) {
                if (f[h1][h2] != INF) {
                    ans = Math.max(ans, f[h1][h2] + Math.max(0, s[n - 1][h2] - s[n - 1][h1]));
                }
            }
        }

        return ans;
    }

    public static void main(String[] args) {
        int[][] grid = {
            {0, 0, 0, 0, 0},
            {0, 0, 3, 0, 0},
            {0, 1, 0, 0, 0},
            {5, 0, 0, 3, 0},
            {0, 0, 0, 0, 2}
        };

        System.out.println(maximumScore(grid));
    }
}

8. Minimum Operations to Make a Uni-Value Grid:

import java.util.Arrays;

public class Main {
    public static int minOperations(int[][] grid, int x) {
        int m = grid.length;
        int n = grid[0].length;
        int[] arr = new int[m * n];
        int k = 0;

        int remainder = grid[0][0] % x;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] % x != remainder) {
                    return -1;
                }
                arr[k++] = grid[i][j];
            }
        }

        Arrays.sort(arr);
        int median = arr[arr.length / 2];

        int operations = 0;
        for (int num : arr) {
            operations += Math.abs(num - median) / x;
        }

        return operations;
    }

    public static void main(String[] args) {
        int[][] grid = {
            {2, 4},
            {6, 8}
        };
        int x = 2;

        
        System.out.println(minOperations(grid, x));
    }
}

