import java.util.*;

class Main {
    public static void main(String[] args) {
        int[] arr = {3, 2, 2, 4, 3};
        int target = 3;

        int n = arr.length;
        int[] best = new int[n + 1];
        Arrays.fill(best, 1000000);

        int ans = 1000000;
        int left = 0, sum = 0;

        for (int right = 0; right < n; right++) {
            sum += arr[right];

            while (sum > target) {
                sum -= arr[left++];
            }

            if (sum == target) {
                int len = right - left + 1;

                if (best[left] != 1000000) {
                    ans = Math.min(ans, len + best[left]);
                }

                best[right + 1] = Math.min(best[right], len);
            } else {
                best[right + 1] = best[right];
            }
        }

        System.out.println(ans == 1000000 ? -1 : ans);
    }
}

